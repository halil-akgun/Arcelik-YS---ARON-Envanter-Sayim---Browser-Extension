{
  "manifest_version": 3,
  "name": "ARON Envanter Sayım",
  "version": "1.0",
  "description": "Arçelik yetkili servis envanter sayımı",
  "permissions": ["storage", "tabs", "scripting", "downloads"],
  "host_permissions": ["https://oasis.arcelik.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "ARON Envanter Sayım",
    "default_icon": "logo.png"
  }
}
